# Copy to .env and fill in. Only API_KEYS is required.

# --- Access ---------------------------------------------------------------------------
# Comma-separated keys. Unity sends one in the X-API-Key header.
# Generate one with:  openssl rand -hex 32
API_KEYS=change-me-to-a-long-random-string
# Hugging Face read token. Only needed for gated models (FLUX Redux, REDUX_STRENGTH > 0).
# Accept the licenses at https://huggingface.co/black-forest-labs/FLUX.1-dev and
# https://huggingface.co/black-forest-labs/FLUX.1-Redux-dev first.
HF_TOKEN=

# --- Image / host paths / port ------------------------------------------------------------
# Image tag from ghcr.io/smitdylan2001/skyboxsystem: latest (main), a version (e.g. 1.2.0) or sha-xxxxxxx.
SKYBOX_TAG=latest
HOST_PORT=8790
# OMV example: /srv/dev-disk-by-uuid-XXXX/appdata/skybox/models
MODELS_PATH=./models
DATA_PATH=./data

# --- API limits -------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_QUEUE=50
# Finished jobs (and their files) are deleted after this many hours.
RESULT_TTL_HOURS=168
# Only needed for Unity WebGL builds, e.g. https://yourgame.example
CORS_ORIGINS=
LOG_LEVEL=INFO

# --- Worker -----------------------------------------------------------------------------
# true = fake pipeline (no GPU/models) to test the API and your Unity shader.
MOCK_PIPELINE=false
# Download all models when the container starts instead of on the first job.
PREFETCH_ON_START=true

# --- Generation -------------------------------------------------------------------------
# Panorama is generated at GEN_WIDTH x GEN_HEIGHT (DiT360 is trained at 2048x1024),
# then upscaled with Real-ESRGAN to OUT_WIDTH x OUT_WIDTH/2.
GEN_WIDTH=2048
GEN_HEIGHT=1024
OUT_WIDTH=4096
STEPS=28
GUIDANCE=2.8
# Seamless left/right edge: rotate the panorama by this many 16 px tokens per step (0 = off),
# then run the last N steps as a two-pass rotation ensemble (each costs one extra transformer pass).
SEAM_ROLL_TOKENS=8
SEAM_ENSEMBLE_STEPS=4
# Panorama LoRA. Fallback option: jbilcke-hf/flux-dev-panorama-lora-2 with
# PANO_LORA_WEIGHT=flux_train_replicate.safetensors, GUIDANCE=3.5 and
# PANO_PROMPT_TEMPLATE=HDRI panoramic view of TOK, {prompt}
PANO_LORA_REPO=Insta360-Research/DiT360-Panorama-Image-Generation
PANO_LORA_WEIGHT=adapter_model.safetensors
PANO_LORA_SCALE=1.0
PANO_PROMPT_TEMPLATE=This is a panorama. The image shows {prompt}
# 0..1: also feed the photo's look into FLUX via Redux (needs HF_TOKEN). 0 = caption only.
REDUX_STRENGTH=0
CAPTION_MODEL=Qwen/Qwen3-VL-2B-Instruct

# --- People removal ---------------------------------------------------------------------
REMOVE_PEOPLE=true
PEOPLE_SCORE=0.5
# Max inpainting crops per job (~8 s each); one crop covers every person that fits inside it.
PEOPLE_MAX_REGIONS=8

# --- Depth ------------------------------------------------------------------------------
# linear | inverse | log  (all near = white, sky = black; see README)
DEPTH_MODE=linear
# Resolution of MoGe's panorama merge (CPU). 1024 ~ a few seconds, 1920 ~ 40 s+.
DEPTH_MERGE_WIDTH=1024
# ADE20K segmentation model used to find the sky (sky = 0 in the depth map).
# MIT-licensed alternative: openmmlab/upernet-convnext-small
SKY_MODEL=nvidia/segformer-b5-finetuned-ade-640-640

JPEG_QUALITY=92
